PORT=3000
NODE_ENV=development
AUTH_MODE=mock
DATABASE_URL="file:./dev.db"
ISSUER="http://localhost:3000"
PUBLIC_BASE_URL="http://localhost:3000"
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800
SESSION_COOKIE_NAME="wega_auth_session"
COOKIE_SECURE=false

# Microsoft Entra ID — obrigatório quando AUTH_MODE=entra
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
ENTRA_REDIRECT_URI="http://localhost:3000/auth/redirect"
ENTRA_SCOPES="openid profile email offline_access User.Read GroupMember.Read.All"

# Opcional: caminhos para par de chaves RSA (geradas automaticamente se ausentes)
JWT_PRIVATE_KEY_PATH="./keys/private.pem"
JWT_PUBLIC_KEY_PATH="./keys/public.pem"
